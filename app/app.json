{
  "expo": {
    "name": "RoadRacer",
    "slug": "roadracer",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "web": {},
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.roadrace.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "package": "com.roadrace.app",
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "RoadRacer uses your calendar to add race events and reminders."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RoadRacer uses your photos so you can set a picture of your bike on the home screen."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "RoadRacer uses your camera to place your face in the rider avatar.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-speech-recognition",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RoadRacer uses your location at the circuit to greet you when you arrive and suggest chatting with your coach."
        }
      ],
      "sentry-expo"
    ],
    "extra": {
      "sentryDsn": "${EXPO_PUBLIC_SENTRY_DSN}",
      "privacyPolicyUrl": "https://github.com/CG-67-R1/Send-It/blob/main/docs/legal/PRIVACY.md",
      "termsOfUseUrl": "https://github.com/CG-67-R1/Send-It/blob/main/docs/legal/TERMS.md"
    }
  }
}
