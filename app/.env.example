# Copy to app/.env to override (optional). Expo loads .env on `npx expo start`.
#
# WARNING: All EXPO_PUBLIC_* vars are embedded in the JS bundle and readable
# by anyone who extracts the APK/IPA. Never put secrets here.
# Secrets (OpenAI key, admin passwords) go in api/.env on the server only.
#
# Default (no .env): https://send-it-ke7r.onrender.com — works for Expo Go and iOS testers.
#
# Local API on your machine (same Wi-Fi as phone, or iOS simulator):
# EXPO_PUBLIC_API_URL=http://localhost:3001
#
# Physical device → LAN IP of dev machine:
# EXPO_PUBLIC_API_URL=http://192.168.1.13:3001
# EXPO_PUBLIC_DEV_MACHINE_IP=192.168.1.13
#
# Must match server APP_API_SECRET when that is set (defence-in-depth; still visible in bundle):
# EXPO_PUBLIC_APP_API_SECRET=change-me-to-a-long-random-string
#
# Crash reporting (optional; leave unset to disable Sentry).
# DSN is public by design (embedded in the JS bundle). Auth token is NOT.
# EXPO_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
#
# EAS production source maps (set as EAS secrets, never commit):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
