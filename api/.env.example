# Copy to .env and fill in. Do not commit .env.

# Required for Rider Coach & Bike Setup in-app AI (POST /roadrace-ai/chat)
OPENAI_API_KEY=sk-...

# Optional: use a different model (default is gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# Shared secret for app → API calls (x-app-secret). When set, /roadrace-ai/*,
# /headlines/custom, and /headlines?refresh=1 require a matching header.
# Use the same value as EXPO_PUBLIC_APP_API_SECRET in the app (bundle-visible;
# defence-in-depth against casual abuse, not a true secret).
# APP_API_SECRET=change-me-to-a-long-random-string

# Peter Bom headlines — public Instagram RSS bridges are unreliable (often 0 items).
# Default feed is Oxley Bom MotoGP podcast (Buzzsprout). Override only if you host a working bridge:
# PETERBOM_PODCAST_FEED_URL=https://feeds.buzzsprout.com/2181509.rss
# PETERBOM_INSTAGRAM_FEED_URL=https://your-rss-bridge/...Instagram&u=peterbom4racing&format=Atom
