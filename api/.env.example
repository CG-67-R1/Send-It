# Copy to .env and fill in. Do not commit .env.

# Required for Rider Coach & Bike Setup in-app AI (POST /roadrace-ai/chat)
OPENAI_API_KEY=sk-...

# Optional: use a different model (default is gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# Shared secret for app → API calls (x-app-secret). When set, /roadrace-ai/*,
# /headlines/custom, /headlines?refresh=1, and /calendar?refresh=1 require a
# matching header. Use the same value as EXPO_PUBLIC_APP_API_SECRET in the app
# (bundle-visible; defence-in-depth against casual abuse, not a true secret).
# Strongly recommended in production whenever OPENAI_API_KEY is set.
# APP_API_SECRET=change-me-to-a-long-random-string

# Optional: extra browser origins allowed by CORS (comma-separated).
# *.vercel.app and *.expo.dev are already allowed.
# CORS_EXTRA_ORIGINS=https://your-custom-domain.com

# Optional: override AI system prompts at runtime (keeps coaching IP out of git).
# Defaults in roadraceAi.js are used when unset.
# COACH_SYSTEM_PROMPT=
# BIKESETUP_SYSTEM_PROMPT=
# ASK_SYSTEM_PROMPT=
# RULES_SYSTEM_PROMPT=

# Peter Bom headlines — public Instagram RSS bridges are unreliable (often 0 items).
# Default feed is Oxley Bom MotoGP podcast (Buzzsprout). Override only if you host a working bridge:
# PETERBOM_PODCAST_FEED_URL=https://feeds.buzzsprout.com/2181509.rss
# PETERBOM_INSTAGRAM_FEED_URL=https://your-rss-bridge/...Instagram&u=peterbom4racing&format=Atom
