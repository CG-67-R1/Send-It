{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadracer.ai/schemas/pack-hierarchy.json",
  "title": "RegionalPackHierarchy",
  "type": "object",
  "required": ["packId", "nodes"],
  "additionalProperties": false,
  "properties": {
    "packId": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "displayName", "kind", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "parentId": { "type": ["string", "null"] },
          "kind": {
            "type": "string",
            "enum": ["region", "country", "subdivision", "coverage_area"]
          },
          "displayName": { "type": "string" },
          "locales": { "type": "array", "items": { "type": "string" } },
          "timezones": { "type": "array", "items": { "type": "string" } },
          "isoCountries": {
            "type": "array",
            "items": { "type": "string" }
          },
          "adminAreas": { "type": "array", "items": { "type": "string" } },
          "status": {
            "type": "string",
            "enum": ["active", "seed", "scaffold"]
          }
        }
      }
    }
  }
}
