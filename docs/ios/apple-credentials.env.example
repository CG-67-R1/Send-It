# Copy to a path outside the repo (or apple-credentials.env at repo root — gitignored).
# Then in PowerShell: Get-Content path\to\apple-credentials.env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { Set-Item -Path "env:$($matches[1].Trim())" -Value $matches[2].Trim() } }

ASC_API_KEY_ID=
ASC_API_ISSUER_ID=
ASC_API_KEY_PATH=C:\Users\Administrator\.secrets\apple\AuthKey_XXXXXXXXXX.p8

# Optional — https://expo.dev → Account settings → Access tokens
EXPO_TOKEN=

# Team ID from developer.apple.com/account → Membership (confirmed Individual)
APPLE_TEAM_ID=UAWP5NV4NQ
