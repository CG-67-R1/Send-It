"problems": {

```
"rear_slide_exit": {
  "category": "traction",
  "subtype": "exit_drive",

  "detect_if": [
    "rear sliding on exit",
    "rear spinning",
    "loss of drive grip"
  ],

  "pattern_links": [
    "heat_related",
    "overpressure",
    "throttle_input"
  ],

  "diagnostic": [
    {
      "check": "hot_pressure",
      "rule": "within_target_range",
      "action_if_false": "adjust_pressure_small_step"
    },
    {
      "check": "symptom_timing",
      "rule": "worse_after_laps",
      "action_if_true": "heat_related_issue"
    },
    {
      "check": "throttle_application",
      "rule": "abrupt_or_early",
      "action_if_true": "rider_input_correction"
    },
    {
      "check": "suspension_behavior",
      "rule": "excess_squat_or_spin",
      "action_if_true": "adjust_rear_damping_small"
    }
  ]
},

"rear_greasy_feel": {
  "category": "traction",
  "subtype": "overheating",

  "detect_if": [
    "greasy feeling",
    "loses grip after few laps",
    "rear feels vague"
  ],

  "pattern_links": [
    "hot_track",
    "overheating"
  ],

  "diagnostic": [
    {
      "check": "track_temp",
      "rule": "high_temp_conditions",
      "action_if_true": "consider_overheating"
    },
    {
      "check": "hot_pressure",
      "rule": "above_target_range",
      "action_if_true": "reduce_pressure_small_step"
    },
    {
      "check": "compound",
      "rule": "too_soft_for_conditions",
      "action_if_true": "consider_harder_compound"
    }
  ]
},

"cold_tear": {
  "category": "tyre_wear",
  "subtype": "cold_tear",

  "detect_if": [
    "fingernail tears",
