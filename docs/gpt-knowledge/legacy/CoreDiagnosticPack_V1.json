"conditions": {

```
"hot_track": {
  "detect_if": {
    "ambient_temp_c": ">=28"
  },
  "risks": [
    "overheating",
    "greasy_feel"
  ],
  "pressure_strategy": {
    "adjustment_range": "+/-0.5 psi",
    "rule": "stay_within_target_window"
  },
  "suspension_bias": [
    "increase_compression",
    "reduce_rebound_if_packing"
  ]
},

"cold_track": {
  "detect_if": {
    "ambient_temp_c": "<=15"
  },
  "risks": [
    "cold_tear",
    "low_grip"
  ],
  "pressure_strategy": {
    "rule": "do_not_reduce_pressure"
  },
  "suspension_bias": [
    "reduce_compression",
    "increase_rebound_slightly"
  ]
}
```

},

